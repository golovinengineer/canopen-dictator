// JetBrains Mono NL (no ligatures, so "0x" stays as typed), bundled because
// no monospace font name exists on every platform. SIL Open Font License 1.1,
// see fonts/OFL-JetBrainsMono.txt.
import "fonts/JetBrainsMonoNL-Regular.ttf";
import { Button, LineEdit, ComboBox, CheckBox, ListView, TextEdit, TabWidget, Palette, ScrollView, AboutSlint } from "std-widgets.slint";

export struct ObjectRow {
    index: int,
    index-text: string,
    name: string,
    kind: string,
    disabled: bool,
    // Group title row ("Communication", ...), not an object.
    header: bool,
}

export struct SubRow {
    sub: int,
    sub-text: string,
    name: string,
    type-name: string,
    access: string,
    pdo: string,
    default-value: string,
}

export struct FormField {
    key: string,
    label: string,
    value: string,
    hint: string,
}

// State pushed in by Rust, and the actions Rust handles. Edits are reported
// as (field, value) string pairs to keep the glue small.
export global App {
    in property <string> status;
    in property <bool> status-is-error;
    in property <string> file-label: "Untitled";
    in property <bool> dirty;

    in property <[ObjectRow]> objects;
    in property <int> selected-index: -1;
    // Position of the selected object in `objects`, header rows included.
    in property <int> selected-row: -1;
    // Rust bumps this to scroll the selected object and subindex into view.
    in property <int> reveal-serial;
    in-out property <string> filter;

    in property <[string]> kind-names;
    in property <[string]> type-names;
    in property <[string]> access-names;
    in property <[string]> pdo-names;

    // Selected object.
    in property <bool> has-object;
    in property <bool> obj-is-var;
    in-out property <string> obj-index-text;
    in-out property <string> obj-name;
    in-out property <int> obj-kind;
    in-out property <bool> obj-enabled;
    in-out property <bool> obj-callback;
    in-out property <string> obj-description;
    in property <string> obj-note;
    in property <[SubRow]> subs;
    in property <int> selected-sub: -1;

    // Selected subindex.
    in property <bool> has-sub;
    in-out property <string> sub-name;
    in-out property <int> sub-type;
    in-out property <int> sub-access;
    in-out property <int> sub-pdo;
    in-out property <string> sub-default;
    in-out property <string> sub-min;
    in-out property <string> sub-max;
    in-out property <string> sub-description;
    in-out property <bool> sub-save;

    in property <[FormField]> device-fields;
    in property <[FormField]> canfestival-fields;
    in property <string> version;

    // Widths the side panes of the Object dictionary tab ask for, set by
    // dragging the splitters; Rust keeps them between runs.
    in-out property <length> wanted-list-width: 340px;
    in-out property <length> wanted-inspector-width: 352px;

    callback new-project();
    callback open-project();
    callback save-project();
    callback save-project-as();
    callback export-c();
    callback export-eds();
    callback export-docs();
    callback export-od();
    callback quit();

    callback filter-changed(string);
    callback select-object(int);
    callback add-object(string, string, string);
    callback delete-object();
    callback object-edited(string, string);
    callback select-sub(int);
    callback add-sub();
    callback delete-sub();
    callback sub-edited(string, string);
    // Focus left the default, minimum or maximum field: show the stored
    // value again in case the typed one was refused.
    callback sub-value-left();
    callback settings-edited(string, string);

    // Checks behind the red outline of a field whose text won't be accepted.
    // A free hex index from 0x1000; the second argument is the object's
    // current index, or -1 for a new one.
    pure callback index-ok(string, int) -> bool;
    // Whether the default, minimum or maximum field (first argument: "default",
    // "min" or "max") will export, given the default, minimum and maximum
    // texts and the type at this position in type-names: it fits the type,
    // the default is inside the limits, the minimum is not above the maximum.
    pure callback value-ok(string, string, string, string, int) -> bool;
    // A value for the setting with this key.
    pure callback setting-ok(string, string) -> bool;
}

global Ui {
    out property <length> gap: 8px;
    out property <length> half-gap: 4px;
    out property <length> row-height: 28px;
    // Secondary text: close to Fluent's own secondary foreground, readable
    // without being mistaken for primary content.
    out property <brush> muted: Palette.foreground.transparentize(0.32);
    out property <relative-font-size> caption-size: 0.93rem;
    out property <length> button-width: 116px;
    out property <length> control-height: 32px;
    out property <brush> hover: Palette.foreground.transparentize(0.93);
    out property <string> mono: "JetBrains Mono NL";
    // Fluent's critical colour.
    out property <brush> error: Palette.color-scheme == ColorScheme.dark ? #ff99a4 : #c42b1c;
}

component Caption inherits Text {
    color: Ui.muted;
    font-size: Ui.caption-size;
    vertical-alignment: center;
}

component Heading inherits Text {
    font-size: 1.1rem;
    font-weight: 600;
    vertical-alignment: center;
}

// A labelled form control: caption above the control.
component Field inherits VerticalLayout {
    in property <string> label;
    spacing: Ui.half-gap;
    alignment: start;
    vertical-stretch: 0;
    Caption {
        text: root.label;
    }

    @children
}

// Outlines its control in red while `invalid`.
component Checked inherits Rectangle {
    in property <bool> invalid;
    VerticalLayout {
        @children
    }

    if root.invalid: Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 4px;
        border-width: 1px;
        border-color: Ui.error;
    }
}

// Every action button has the same size, whatever its label.
component ActionButton inherits Button {
    width: Ui.button-width;
}

component Separator inherits Rectangle {
    background: Palette.border;
}

// A vertical divider that can be dragged sideways. Reports how far the
// pointer moved since the last report; the owner moves the divider by
// resizing a neighbouring pane, which keeps the pointer over it.
component Splitter inherits Rectangle {
    callback dragged(length);
    width: 5px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        width: touch.pressed || touch.has-hover ? 3px : 1px;
        background: touch.pressed || touch.has-hover ? Palette.accent-background : Palette.border;
    }

    touch := TouchArea {
        mouse-cursor: col-resize;
        moved => {
            root.dragged(self.mouse-x - self.pressed-x);
        }
    }
}

// Required by the Slint royalty-free licence: AboutSlint reachable from the
// top level of the application.
component AboutDialog inherits PopupWindow {
    close-policy: close-on-click-outside;
    Rectangle {
        background: Palette.background;
        border-color: Palette.border;
        border-width: 1px;
        border-radius: 6px;
        VerticalLayout {
            padding: 2 * Ui.gap;
            spacing: Ui.gap;
            HorizontalLayout {
                spacing: Ui.gap * 1.5;
                alignment: start;
                Image {
                    source: Palette.color-scheme == ColorScheme.dark ? @image-url("../assets/icon/png/dictator-dark-256.png") : @image-url("../assets/icon/png/dictator-256.png");
                    width: 96px;
                    height: 96px;
                }

                VerticalLayout {
                    alignment: center;
                    Heading {
                        text: "Dictator " + App.version;
                    }

                    Text {
                        text: "CANopen object dictionary editor";
                    }
                }
            }

            Caption {
                text: "Licensed under MIT OR Apache-2.0.\nThe CanFestival C generator (dictator-canfestival) is a port of\nCanFestival objdictgen by E. Tisserant, F. Dupin and L. Bessard\nand is licensed under LGPL-2.1-or-later.\nJetBrains Mono typeface © The JetBrains Mono Project Authors,\nSIL Open Font License 1.1.";
                wrap: word-wrap;
            }

            AboutSlint {
                preferred-height: 96px;
            }
        }
    }
}

component ObjectItem inherits Rectangle {
    in property <ObjectRow> item;
    in property <bool> selected;
    callback clicked();
    height: Ui.row-height;
    background: item.header ? Palette.alternate-background : selected ? Palette.selection-background : touch.has-hover ? Ui.hover : transparent;
    touch := TouchArea {
        enabled: !item.header;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: Ui.gap;
        padding-right: Ui.gap;
        spacing: Ui.gap;
        if item.header: Caption {
            text: item.name;
            font-weight: 600;
        }
        if !item.header: Text {
            text: item.index-text;
            width: 52px;
            font-family: Ui.mono;
            vertical-alignment: center;
            color: root.selected ? Palette.selection-foreground : item.disabled ? Ui.muted : Palette.foreground;
        }
        if !item.header: Text {
            text: item.name;
            horizontal-stretch: 1;
            overflow: elide;
            vertical-alignment: center;
            color: root.selected ? Palette.selection-foreground : item.disabled ? Ui.muted : Palette.foreground;
        }
        if !item.header: Text {
            text: item.kind;
            font-size: Ui.caption-size;
            vertical-alignment: center;
            color: root.selected ? Palette.selection-foreground : Ui.muted;
        }
    }
}

component SubCells inherits HorizontalLayout {
    in property <SubRow> item;
    in property <brush> color: Palette.foreground;
    in property <int> weight: 400;
    in property <string> mono: Ui.mono;
    padding-left: Ui.gap;
    padding-right: Ui.gap;
    spacing: Ui.gap;
    Text {
        text: item.sub-text;
        width: 40px;
        font-family: root.mono;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }

    Text {
        text: item.name;
        horizontal-stretch: 1;
        overflow: elide;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }

    Text {
        text: item.type-name;
        width: 100px;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }

    Text {
        text: item.access;
        width: 52px;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }

    Text {
        text: item.pdo;
        width: 64px;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }

    Text {
        text: item.default-value;
        width: 130px;
        overflow: elide;
        font-family: root.mono;
        vertical-alignment: center;
        color: root.color;
        font-weight: root.weight;
    }
}

component SubItem inherits Rectangle {
    in property <SubRow> item;
    in property <bool> selected;
    callback clicked();
    height: Ui.row-height;
    background: selected ? Palette.selection-background : touch.has-hover ? Ui.hover : transparent;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    SubCells {
        item: root.item;
        color: root.selected ? Palette.selection-foreground : Palette.foreground;
    }
}

component FormRows inherits VerticalLayout {
    in property <[FormField]> fields;
    spacing: Ui.gap;
    for f in root.fields: HorizontalLayout {
        spacing: Ui.gap;
        Text {
            text: f.label;
            width: 180px;
            vertical-alignment: center;
        }

        Checked {
            width: 280px;
            invalid: !App.setting-ok(f.key, value.text);
            value := LineEdit {
                text: f.value;
                edited(text) => {
                    App.settings-edited(f.key, text);
                }
            }
        }

        Caption {
            text: f.hint;
            horizontal-stretch: 1;
        }
    }
}

component ObjectList inherits VerticalLayout {
    property <bool> adding;
    property <int> reveal-serial: App.reveal-serial;
    changed reveal-serial => {
        if App.selected-row >= 0 {
            list.ensure-row-visible(App.selected-row, ScrollBehavior.smooth);
        }
    }
    spacing: Ui.gap;
    padding: Ui.gap;
    Field {
        label: "Filter";
        LineEdit {
            placeholder-text: "Index or name";
            text <=> App.filter;
            edited(text) => {
                App.filter-changed(text);
            }
        }
    }

    HorizontalLayout {
        spacing: Ui.gap;
        ActionButton {
            text: root.adding ? "Cancel" : "Add object";
            clicked => {
                root.adding = !root.adding;
            }
        }

        ActionButton {
            text: "Delete";
            enabled: App.has-object;
            clicked => {
                App.delete-object();
            }
        }

        Rectangle { }
    }

    if root.adding: Rectangle {
        background: Palette.alternate-background;
        border-radius: 6px;
        VerticalLayout {
            padding: Ui.gap;
            spacing: Ui.gap;
            HorizontalLayout {
                spacing: Ui.gap;
                Field {
                    label: "Index (hex)";
                    width: Ui.button-width;
                    Checked {
                        invalid: new-index.text != "" && !App.index-ok(new-index.text, -1);
                        new-index := LineEdit {
                            // Fluent's LineEdit is at least 160px wide and would
                            // spill under the Kind box; four hex digits fit here.
                            min-width: 0px;
                            placeholder-text: "2000";
                        }
                    }
                }

                Field {
                    label: "Kind";
                    new-kind := ComboBox {
                        // "record" needs far less than Fluent's 160px minimum,
                        // and this way the form is no wider than the buttons.
                        min-width: 100px;
                        model: App.kind-names;
                        current-index: 0;
                    }
                }
            }

            Field {
                label: "Name";
                new-name := LineEdit {
                    placeholder-text: "New object";
                    accepted => {
                        if create.enabled {
                            create.clicked();
                        }
                    }
                }
            }

            create := ActionButton {
                text: "Create";
                primary: true;
                enabled: App.index-ok(new-index.text, -1);
                clicked => {
                    App.add-object(new-index.text, new-name.text, new-kind.current-value);
                    root.adding = false;
                }
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 6px;
        clip: true;
        vertical-stretch: 1;
        list := ListView {
            for entry in App.objects: ObjectItem {
                item: entry;
                selected: !entry.header && entry.index == App.selected-index;
                clicked => {
                    App.select-object(entry.index);
                }
            }
        }
    }
}

component ObjectPane inherits VerticalLayout {
    property <int> reveal-serial: App.reveal-serial;
    changed reveal-serial => {
        if App.selected-sub >= 0 {
            subs.ensure-row-visible(App.selected-sub, ScrollBehavior.smooth);
        }
    }
    spacing: Ui.gap;
    padding: Ui.gap;
    GridLayout {
        spacing-horizontal: Ui.gap;
        spacing-vertical: Ui.gap;
        Row {
            Field {
                label: "Index (hex, Enter to apply)";
                width: 210px;
                Checked {
                    invalid: !App.index-ok(index.text, App.selected-index);
                    index := LineEdit {
                        text <=> App.obj-index-text;
                        font-family: Ui.mono;
                        accepted => {
                            App.object-edited("index", self.text);
                        }
                    }
                }
            }

            Field {
                label: "Name";
                horizontal-stretch: 1;
                LineEdit {
                    min-width: 120px;
                    text <=> App.obj-name;
                    edited(text) => {
                        App.object-edited("name", text);
                    }
                }
            }

            Field {
                label: "Kind";
                width: 160px;
                ComboBox {
                    model: App.kind-names;
                    current-index <=> App.obj-kind;
                    selected(value) => {
                        App.object-edited("kind", value);
                    }
                }
            }
        }

        Row {
            CheckBox {
                height: Ui.control-height;
                text: "Enabled (included in exports)";
                checked <=> App.obj-enabled;
                toggled => {
                    App.object-edited("enabled", self.checked ? "true" : "false");
                }
            }

            CheckBox {
                height: Ui.control-height;
                text: "CanFestival callbacks";
                checked <=> App.obj-callback;
                toggled => {
                    App.object-edited("callback", self.checked ? "true" : "false");
                }
            }
        }
    }

    if App.obj-note != "": Caption {
        text: App.obj-note;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    Field {
        label: "Description";
        TextEdit {
            height: 72px;
            text <=> App.obj-description;
            edited(text) => {
                App.object-edited("description", text);
            }
        }
    }

    HorizontalLayout {
        spacing: Ui.gap;
        Heading {
            text: App.obj-is-var ? "Value" : "Subindexes";
            horizontal-stretch: 1;
        }

        ActionButton {
            text: "Add subindex";
            enabled: !App.obj-is-var;
            clicked => {
                App.add-sub();
            }
        }

        ActionButton {
            text: "Remove";
            enabled: !App.obj-is-var && App.has-sub;
            clicked => {
                App.delete-sub();
            }
        }
    }

    Rectangle {
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 6px;
        clip: true;
        vertical-stretch: 1;
        VerticalLayout {
            Rectangle {
                height: Ui.row-height;
                background: Palette.alternate-background;
                SubCells {
                    item: {
                        sub-text: "Sub",
                        name: "Name",
                        type-name: "Type",
                        access: "Access",
                        pdo: "PDO",
                        default-value: "Default",
                    };
                    color: Ui.muted;
                    weight: 600;
                    mono: "";
                }
            }

            subs := ListView {
                for entry[i] in App.subs: SubItem {
                    item: entry;
                    selected: i == App.selected-sub;
                    clicked => {
                        App.select-sub(i);
                    }
                }
            }
        }
    }
}

component SubInspector inherits VerticalLayout {
    spacing: Ui.gap;
    padding: Ui.gap;
    alignment: start;
    Field {
        label: App.obj-is-var ? "Value name (same as object)" : "Subindex name";
        LineEdit {
            enabled: !App.obj-is-var;
            text <=> App.sub-name;
            edited(text) => {
                App.sub-edited("name", text);
            }
        }
    }

    HorizontalLayout {
        spacing: Ui.gap;
        // Both boxes fit "VISIBLE_STRING" and "const" below Fluent's 160px
        // minimum, letting the inspector get narrower.
        Field {
            label: "Data type";
            ComboBox {
                min-width: 140px;
                model: App.type-names;
                current-index <=> App.sub-type;
                selected(value) => {
                    App.sub-edited("type", value);
                }
            }
        }

        Field {
            label: "Access";
            ComboBox {
                min-width: 140px;
                model: App.access-names;
                current-index <=> App.sub-access;
                selected(value) => {
                    App.sub-edited("access", value);
                }
            }
        }
    }

    Field {
        label: "PDO mapping";
        ComboBox {
            model: App.pdo-names;
            current-index <=> App.sub-pdo;
            selected(value) => {
                App.sub-edited("pdo", value);
            }
        }
    }

    Field {
        label: "Default value";
        Checked {
            invalid: !App.value-ok("default", default.text, min.text, max.text, App.sub-type);
            default := LineEdit {
                text <=> App.sub-default;
                font-family: Ui.mono;
                placeholder-text: "0, 0x10, $NODEID+0x180, text";
                edited(text) => {
                    App.sub-edited("default", text);
                }
                changed has-focus => {
                    if !self.has-focus {
                        App.sub-value-left();
                    }
                }
            }
        }
    }

    HorizontalLayout {
        spacing: Ui.gap;
        Field {
            label: "Minimum";
            Checked {
                invalid: !App.value-ok("min", default.text, min.text, max.text, App.sub-type);
                min := LineEdit {
                    min-width: 140px;
                    text <=> App.sub-min;
                    edited(text) => {
                        App.sub-edited("min", text);
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            App.sub-value-left();
                        }
                    }
                }
            }
        }

        Field {
            label: "Maximum";
            Checked {
                invalid: !App.value-ok("max", default.text, min.text, max.text, App.sub-type);
                max := LineEdit {
                    min-width: 140px;
                    text <=> App.sub-max;
                    edited(text) => {
                        App.sub-edited("max", text);
                    }
                    changed has-focus => {
                        if !self.has-focus {
                            App.sub-value-left();
                        }
                    }
                }
            }
        }
    }

    CheckBox {
        text: "Save to non-volatile memory (TO_BE_SAVE)";
        checked <=> App.sub-save;
        toggled => {
            App.sub-edited("save", self.checked ? "true" : "false");
        }
    }

    Field {
        label: "Description";
        TextEdit {
            height: 160px;
            enabled: !App.obj-is-var;
            text <=> App.sub-description;
            edited(text) => {
                App.sub-edited("description", text);
            }
        }
    }

    if App.obj-is-var: Caption {
        text: "A VAR keeps its description on the object.";
    }
}

component Placeholder inherits Rectangle {
    in property <string> text;
    Caption {
        text: root.text;
        horizontal-alignment: center;
    }
}

// The object list, the selected object and the subindex inspector, divided
// by splitters. Dragging a splitter sets the width a side pane asks for;
// the side panes give that width up, down to their minimum, whenever the
// window is too narrow to leave the middle pane its minimum, and take it
// back as the window widens again.
component Panes inherits Rectangle {
    // Minimums follow the contents: the list's two buttons with the pane's
    // padding (the Add object form fits the same width), the object pane's
    // index/name/kind row and subindex columns, the inspector's two combo
    // boxes side by side.
    property <length> list-min: 2 * Ui.button-width + 3 * Ui.gap;
    property <length> list-max: 560px;
    property <length> pane-min: 540px;
    property <length> inspector-min: 304px;
    property <length> inspector-max: 560px;
    property <length> splitter-width: 5px;

    // The list takes precedence over the inspector when space runs out.
    property <length> list-width: max(root.list-min, min(App.wanted-list-width, root.list-max, root.width - 2 * root.splitter-width - root.pane-min - (App.has-object ? root.inspector-min : 0px)));
    property <length> inspector-width: max(root.inspector-min, min(App.wanted-inspector-width, root.inspector-max, root.width - 2 * root.splitter-width - root.pane-min - root.list-width));

    // Fixed, so the window's minimum doesn't depend on the current widths.
    min-width: self.list-min + self.pane-min + self.inspector-min + 2 * self.splitter-width;
    min-height: panes.min-height;

    // Placed explicitly so that Panes doesn't take its size hints from the
    // layout: those depend on the widths above, which depend on Panes' width.
    // Heights don't, so the minimum height is still taken from it.
    panes := HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        ObjectList {
            width: root.list-width;
        }

        Splitter {
            dragged(dx) => {
                // Clamp the request itself, so dragging past a limit and
                // back responds at once instead of after the overshoot.
                App.wanted-list-width = max(root.list-min, min(root.list-width + dx, root.list-max));
            }
        }

        if App.has-object: ObjectPane {
            horizontal-stretch: 1;
        }
        if App.has-object: Splitter {
            dragged(dx) => {
                App.wanted-inspector-width = max(root.inspector-min, min(root.inspector-width - dx, root.inspector-max));
            }
        }
        // Scrolls rather than cuts off its lower fields in a short window.
        if App.has-object && App.has-sub: scroller := ScrollView {
            width: root.inspector-width;
            content-width: self.visible-width;
            content-height: max(self.visible-height, inspector.min-height);
            inspector := SubInspector {
                x: 0;
                y: 0;
                width: scroller.content-width;
                height: scroller.content-height;
            }
        }
        if App.has-object && !App.has-sub: Placeholder {
            width: root.inspector-width;
            text: "Select a subindex to edit it";
        }
        if !App.has-object: Placeholder {
            horizontal-stretch: 1;
            text: "Select an object, or add one";
        }
    }
}

export component MainWindow inherits Window {
    title: (App.dirty ? "● " : "") + App.file-label + " - Dictator";
    icon: @image-url("../assets/icon/png/dictator-256.png");
    preferred-width: 1320px;
    preferred-height: 780px;
    // The minimum width comes from the panes.
    min-height: 560px;
    background: Palette.background;

    about := AboutDialog {
        x: (root.width - 460px) / 2;
        y: 60px;
        width: 460px;
    }

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New";
                shortcut: @keys(Control + N);
                activated => {
                    App.new-project();
                }
            }

            MenuItem {
                title: "Open…";
                shortcut: @keys(Control + O);
                activated => {
                    App.open-project();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Save";
                shortcut: @keys(Control + S);
                activated => {
                    App.save-project();
                }
            }

            MenuItem {
                title: "Save As…";
                shortcut: @keys(Control + Shift + S);
                activated => {
                    App.save-project-as();
                }
            }

            MenuSeparator { }

            Menu {
                title: "Export";
                MenuItem {
                    title: "CanFestival C code…";
                    shortcut: @keys(Control + Shift + C);
                    activated => {
                        App.export-c();
                    }
                }

                MenuItem {
                    title: "CanFestival OD…";
                    shortcut: @keys(Control + Shift + O);
                    activated => {
                        App.export-od();
                    }
                }

                MenuItem {
                    title: "EDS…";
                    shortcut: @keys(Control + Shift + E);
                    activated => {
                        App.export-eds();
                    }
                }

                MenuItem {
                    title: "Documentation…";
                    shortcut: @keys(Control + Shift + D);
                    activated => {
                        App.export-docs();
                    }
                }
            }

            MenuSeparator { }

            // On macOS this moves to the application menu, replacing its Quit.
            MenuItem {
                title: Platform.os == OperatingSystemType.macos ? "Quit Dictator" : "Quit";
                role: MenuItemRole.quit;
                shortcut: @keys(Control + Q);
                activated => {
                    App.quit();
                }
            }

            // macOS titles the default Hide item after the executable,
            // lowercase; this only replaces the title, Hide still works.
            if Platform.os == OperatingSystemType.macos: MenuItem {
                title: "Hide Dictator";
                role: MenuItemRole.hide;
            }
        }

        Menu {
            title: "Help";
            // On macOS this moves to the application menu.
            MenuItem {
                title: "About Dictator";
                role: MenuItemRole.about;
                activated => {
                    about.show();
                }
            }
        }
    }

    VerticalLayout {
        TabWidget {
            vertical-stretch: 1;
            Tab {
                title: "Object dictionary";
                Panes { }
            }

            Tab {
                title: "Device and generator settings";
                ScrollView {
                    VerticalLayout {
                        padding: Ui.gap * 2;
                        spacing: Ui.gap * 2;
                        alignment: start;
                        Heading {
                            text: "Device";
                        }

                        FormRows {
                            fields: App.device-fields;
                        }

                        Heading {
                            text: "CanFestival C generator";
                        }

                        FormRows {
                            fields: App.canfestival-fields;
                        }
                    }
                }
            }
        }

        Separator {
            height: 1px;
        }

        HorizontalLayout {
            padding-left: Ui.gap;
            padding-right: Ui.gap;
            height: 26px;
            Text {
                text: App.status;
                color: App.status-is-error ? #d13438 : Ui.muted;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
