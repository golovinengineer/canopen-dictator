            <label lang="en">Demo integer64</label>
            <LINT />
            <q1:defaultValue value="-1" />
          </q1:parameter>
          <q1:parameter uniqueID="UID_OBJ_2005">
            <description lang="en">Read-only, mapped to TPDO 1; a change triggers the TPDO (CO_flagsPDO).</description>
            <USINT />
            <q1:defaultValue value="0x2A" />
            <q1:property name="CO_flagsPDO" value="true" />
          </q1:parameter>
